{
	"name": "pretty-pet-frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"homepage": "https://prettypet-organization.github.io/frontend-react/",
	"scripts": {
		"prepare": "husky",
		"start": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"tsc": "tsc --project tsconfig.app.json",
		"lint": "eslint . --ext .js,.jsx,.ts,.tsx",
		"lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
		"format": "prettier . --write --ignore-unknown --ignore-path .prettierignore --log-level error",
		"check": "npm run tsc && npm run lint:fix && npm run format",
		"predeploy": "npm run build && cp dist/index.html dist/404.html",
		"deploy": "gh-pages -d dist"
	},
	"lint-staged": {
		"*.{ts,tsx}": "bash -c 'tsc --project tsconfig.app.json'",
		"*.{js,jsx,ts,tsx}": "eslint --fix",
		"*": "prettier --write --ignore-unknown --ignore-path .prettierignore --log-level error"
	},
	"config": {
		"commitizen": {
			"path": "cz-conventional-changelog"
		}
	},
	"dependencies": {
		"@ant-design/v5-patch-for-react-19": "^1.0.3",
		"@reduxjs/toolkit": "^2.8.2",
		"@tailwindcss/vite": "^4.1.10",
		"antd": "^5.26.1",
		"axios": "^1.11.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-redux": "^9.2.0",
		"react-router-dom": "^7.6.2"
	},
	"devDependencies": {
		"@eslint/js": "^9.25.0",
		"@types/node": "^24.7.2",
		"@types/react": "^19.1.2",
		"@types/react-dom": "^19.1.2",
		"@vitejs/plugin-react": "^4.4.1",
		"autoprefixer": "^10.4.21",
		"babel-plugin-react-compiler": "^1.0.0",
		"commitizen": "^4.3.1",
		"cz-conventional-changelog": "^3.3.0",
		"eslint": "^9.25.0",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.19",
		"gh-pages": "^6.3.0",
		"globals": "^16.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.4",
		"postcss": "^8.5.6",
		"prettier": "^3.6.2",
		"sass": "^1.89.2",
		"sass-embedded": "^1.89.2",
		"tailwindcss": "^4.1.10",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.30.1",
		"vite": "^7.1.10"
	}
}
